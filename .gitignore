# ================================
# ZensaxPulse - Git Ignore
# ================================

# Node.js dependencies
node_modules/

# Frontend build output
dist/
dist-ssr/
*.local

# Rust build artifacts
src-tauri/target/

# Tauri generated files
src-tauri/gen/schemas/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager files
.npm/
.pnpm-store/

# IDEs and editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
